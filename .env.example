# Supabase project (Project Settings -> API). The anon / publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used solely by Settings -> Users -> "Add user". Never prefix with NEXT_PUBLIC_.
# Leave blank to manage users from the Supabase dashboard instead.
SUPABASE_SERVICE_ROLE_KEY=

# Shows the demo accounts on the login page. Set to false (or remove) outside demos.
NEXT_PUBLIC_DEMO_MODE=true
